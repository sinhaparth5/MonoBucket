# MonoBucket on the VPS. Copy to deploy/.env and fill in.
#
#   cp deploy/.env.example deploy/.env
#   ${EDITOR:-vi} deploy/.env

# The published image tag. Must be a release that exists in ghcr.io — check
# https://github.com/sinhaparth5/MonoBucket/pkgs/container/monobucket before
# deploying. `edge` is master's latest build and is not a release.
MONOBUCKET_VERSION=2026.08.4

# Reported by GetBucketLocation and signed into every SigV4 request, so clients
# must be configured with the same value. us-east-1 is also the only region in
# which S3 makes CreateBucket idempotent for the owner; anywhere else a repeat
# create is a 409. Keep it unless you have a reason.
MONOBUCKET_REGION=us-east-1

# The origin S3 clients reach this deployment at. The console signs this as the
# host of every presigned URL and writes object links against it. Unset, it
# falls back to the console's own hostname and MONOBUCKET_PORT — which behind a
# proxy is an address that exists nowhere, and produces SignatureDoesNotMatch.
MONOBUCKET_S3_PUBLIC_URL=https://s3.wepyxis.space

# --- Console -----------------------------------------------------------------
MONOBUCKET_ADMIN_USERNAME=admin
# The password itself lives in secrets/admin_password.txt, never here.

# --- S3 break-glass credential -----------------------------------------------
# Generate, do not invent:
#   head -c 20 /dev/urandom | base64 | tr -d '/+=' | head -c 20
#   head -c 40 /dev/urandom | base64 | tr -d '/+=' | head -c 40
MONOBUCKET_ROOT_ACCESS_KEY=
MONOBUCKET_ROOT_SECRET_KEY=

# --- Storage allocations ------------------------------------------------------
# What MonoBucket may divide among buckets. It counts object bytes only — the
# same volume also holds RocksDB's metadata, streaming temporaries in tmp/, and
# during a multipart completion a second copy of the object while the parts are
# concatenated. Allocating the whole volume means the first large multipart
# upload fills it. 22GiB of a 30 GB (27.9 GiB) volume leaves ~6 GiB of room.
MONOBUCKET_ALLOCATABLE_BYTES=22GiB

# What a bucket created by `aws s3 mb` gets, since CreateBucket has no field for
# an allocation. 0 leaves those buckets unlimited; set a figure if you want
# every route into the server to produce a sized bucket.
MONOBUCKET_DEFAULT_BUCKET_QUOTA_BYTES=0

# --- Durability and limits -----------------------------------------------------
MONOBUCKET_DURABILITY=strict
MONOBUCKET_METADATA_MEMORY_BYTES=32MiB
MONOBUCKET_CACHE_MAX_BYTES=128MiB
MONOBUCKET_MEMORY_LIMIT=512M

# Leave false until the WAF denies /metrics and /readyz on both services — both
# answer unauthenticated on the S3 hostname as well as the console one.
MONOBUCKET_METRICS_ENABLED=false

MONOBUCKET_LOG_LEVEL=info

# --- Not set on purpose --------------------------------------------------------
# MONOBUCKET_S3_DOMAIN turns on virtual-host-style addressing
# (photos.s3.wepyxis.space). Leaving it unset keeps path-style
# (s3.wepyxis.space/photos), which needs one A record and one certificate
# rather than a wildcard of each. Set it only once you have *.s3.wepyxis.space
# in DNS and on the certificate.
# MONOBUCKET_S3_DOMAIN=s3.wepyxis.space
